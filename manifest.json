{
  "manifest_version": 3,
  "name": "Guided Setup Tour",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs", "webNavigation", "sidePanel"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Guided Setup Tour" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+G" } }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: blob:; frame-src 'none'"
  }
}
